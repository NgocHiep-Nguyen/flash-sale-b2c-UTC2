# ===================================================================
# Flash Sale B2C - Profile local cho moi truong phat trien
# Copy file nay thanh application-local.yaml roi dien secret thaym jen
# application-local.yaml KHONG commit (da duoc .gitignore che)
# ===================================================================

spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/flash_sale_b2c
    username: postgres
    password: postgres
  jpa:
    hibernate:
      ddl-auto: validate
  data:
    redis:
      host: localhost
      port: 6379

# --- Cloudinary ---
# TODO: Diem 3 bien sau vao account Cloudinary cua ban (free tier OK)
# Dang khi lay o https://cloudinary.com/console
cloudinary:
  cloud-name: YOUR_CLOUD_NAME
  api-key: YOUR_API_KEY
  api-secret: YOUR_API_SECRET
  folder: flash-sale-b2c/local

# --- JWT (dev) ---
jwt:
  secret: dev-secret-do-not-use-in-production-min-64-chars-aaaaaaaaaaaaaaaaaa