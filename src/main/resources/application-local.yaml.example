# ===================================================================
# Flash Sale B2C - Local Development Profile (EXAMPLE TEMPLATE)
# File mẫu được đẩy lên GitHub để hướng dẫn cấu hình môi trường local.
#
# Hướng dẫn sử dụng:
# 1. Tạo bản sao file này và đặt tên là: application-local.yaml
# 2. Điền thông tin kết nối PostgreSQL và Redis trên máy cá nhân của bạn
# 3. File application-local.yaml đã nằm trong .gitignore và sẽ không bị đẩy lên GitHub.
# ===================================================================

spring:
  config:
    activate:
      on-profile: local

  # --- Kết nối CSDL PostgreSQL Local ---
  datasource:
    url: jdbc:postgresql://localhost:5432/flash_sale_db
    username: postgres
    password: postgres
    driver-class-name: org.postgresql.Driver
    hikari:
      pool-name: FlashSaleLocalHikariPool
      maximum-pool-size: 10
      minimum-idle: 5
      idle-timeout: 300000
      connection-timeout: 20000
      max-lifetime: 1200000

  # --- JPA / Hibernate Cấu hình cho Local Dev ---
  jpa:
    show-sql: true
    properties:
      hibernate:
        format_sql: true
        highlight_sql: true

  # --- Cấu hình Redis Local (Distributed Lock & Caching) ---
  data:
    redis:
      host: localhost
      port: 6379
      password: ""
      timeout: 3000ms

# --- Logging chi tiết cho môi trường Local ---
logging:
  level:
    root: INFO
    com.b2c: DEBUG
    org.hibernate.SQL: DEBUG
    org.hibernate.orm.jdbc.bind: TRACE
